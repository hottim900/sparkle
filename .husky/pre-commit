# === Block commit on main ===
branch=$(git branch --show-current)
if [ "$branch" = "main" ]; then
  echo ""
  echo "  ERROR: 禁止在 main 上 commit。請先建立 feature branch："
  echo ""
  echo "    git checkout -b {type}/{short-description}"
  echo ""
  echo "  如果已經有 commit 在 main 上，用以下指令修復："
  echo ""
  echo "    git checkout -b feat/my-feature    # 帶著 commits 切到新 branch"
  echo "    git push -u origin feat/my-feature  # push 新 branch"
  echo "    git checkout main && git reset --hard origin/main  # 重置 local main"
  echo ""
  exit 1
fi

# Branch name convention check (POSIX sh compatible — husky runs hooks with sh)
case "$branch" in
  feat/*|fix/*|docs/*|chore/*|refactor/*|test/*|perf/*|ci/*|build/*|style/*|revert/*)
    ;; # valid
  *)
    echo ""
    echo "ERROR: Branch 名稱 '$branch' 不符合 {type}/{short-description} 格式。"
    echo "允許的 types: feat, fix, docs, chore, refactor, test, perf, ci, build, style, revert"
    echo "範例: fix/error-boundary, feat/aria-labels"
    echo ""
    exit 1
    ;;
esac

# === CLAUDE.md / skills update warning ===
has_code_change=$(git diff --cached --name-only | grep -qE '^(mcp-server|server|src|scripts|docs)/' && echo true || echo false)
has_doc_change=$(git diff --cached --name-only | grep -qE '^(CLAUDE\.md|\.claude/skills/)' && echo true || echo false)

if [ "$has_code_change" = "true" ] && [ "$has_doc_change" = "false" ]; then
  echo ""
  echo "  Source directories changed but CLAUDE.md/skills were not updated."
  echo "   If this change affects documentation, update the relevant file now."
  echo "   Committing anyway (this is a warning, not a block)."
  echo ""
fi

# === Type check ===
if [ "$SKIP_TSC" != "1" ]; then
  echo "Running tsc --noEmit (client)..."
  npx tsc --noEmit || exit 1
  echo "Running tsc --noEmit (server)..."
  npx tsc --noEmit -p tsconfig.server.json || exit 1
fi

# === v1.4.0 split-table guard ===
# Block raw FROM/UPDATE/DELETE FROM "items" references in staged server/src code.
# Word boundaries (\b...\b) avoid false positives on `items.id`, `items_fts`, `items_active`.
# Migration code in server/db/index.ts legitimately mentions legacy `items` during
# v11→v12 and v22→v23; exclude it from the guard.
staged_items_refs=$(git diff --cached --name-only -- server/ src/ mcp-server/src/ 2>/dev/null \
  | grep -v '^server/db/index\.ts$' \
  | xargs -r grep -nE '\b(FROM|UPDATE|DELETE FROM)\s+items\b' 2>/dev/null || true)
if [ -n "$staged_items_refs" ]; then
  echo ""
  echo "❌ Raw 'FROM|UPDATE|DELETE FROM items' references blocked."
  echo "   Use items_active or items_vault."
  echo ""
  echo "$staged_items_refs"
  exit 1
fi

# === lint-staged ===
npx lint-staged

# === Format check (catches anything lint-staged missed) ===
echo "Running format:check..."
npm run format:check || {
  echo ""
  echo "  ERROR: Prettier formatting issues found."
  echo "  Run: npm run format"
  echo ""
  exit 1
}
